# ============================================================================
# 前端配置（Vite 只暴露 VITE_ 前缀的变量到浏览器）
# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。
# ============================================================================

# 后端 API 地址（FastAPI）
VITE_API_BASE=http://127.0.0.1:8000

# false（默认，可省略）= 调用真实后端接口。`pnpm dev` 就是这个模式。
# true               = 使用内置演示数据，完全不请求后端。对应 `pnpm dev:mock`。
#
# 为什么不默认开启演示数据：内置的假排期会让仪表盘看起来「已经有内容」，
# 而实际本地库是空的。真实店铺连接才是这个平台的默认状态。
VITE_USE_MOCK=false

# ============================================================================
# 以下变量由**后端**读取，不会被前端打包进浏览器。
# 前端只认识掩码与「来源」标记，永不接触明文 token。
# ============================================================================

# Shopify 店铺域名
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API 访问令牌（shpat_ 开头）
# ⚠️ 不要提交真实 token。若曾提交过，请在 Shopify 后台重新签发。
SHOPIFY_ACCESS_TOKEN=

# Admin API 版本
SHOPIFY_API_VERSION=2026-04

# 使用 OAuth client_credentials 流程换发 token 时需要（可选）
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# 默认时区与作者（统一上海时区，与店铺 ianaTimezone 一致）
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_AUTHOR=ZimaSpace

# 默认评审人（逗号分隔，可留空）。**代码里故意不内置姓名** —— 真实的人属于
# 个人信息，不该进仓库。也可以直接在「全局设置」界面里填（存 data/settings.json）。
DEFAULT_REVIEWERS=

# SQLite 数据库文件路径
DATABASE_PATH=./data/zima_shopify.db

# ============================================================================
# 容器部署（docker compose）额外需要的
# ============================================================================

# 后端监听地址。本地开发用 127.0.0.1；容器里必须 0.0.0.0 才能被宿主访问。
# 注意 Dockerfile 里 CMD 已经写死 --host 0.0.0.0，这里一般不用改。
API_HOST=0.0.0.0

# 前端构建产物目录。存在时由后端顺带托管（容器里就是这么用的：单端口、同源）。
# 本地开发不构建前端，这个目录不存在 → 自动跳过托管。
FRONTEND_DIST=/app/dist

# 后台对账间隔（分钟）。0 = 关闭。
SYNC_INTERVAL_MINUTES=15

# 日志时间戳用哪个时区。**只影响日志可读性** —— 后端全程用 UTC，
# 排期时间以「带偏移的 ISO」传递，时区换算在前端做，所以这个值不影响发布正确性。
TZ=Asia/Shanghai
