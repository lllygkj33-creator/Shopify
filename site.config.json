          "document",
          "docs",
          "see the guide",
          "see this guide",
          "read the guide",
          "read this guide",
          "click here",
          "learn more here",
          "more information"
        ],
        "forbiddenPlaceholders": [
          "YOUTUBE_URL_",
          "YOUTUBE_VIDEO_ID_",
          "BLOG_URL_",
          "BLOG_COVER_IMAGE_URL_",
          "PLACEHOLDER",
          "TODO",
          "Replace with"
