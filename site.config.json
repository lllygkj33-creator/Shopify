        "metaDescriptionMin": 120,
        "metaTitleMax": 65,
        "requireDecodingAsync": true,
        "requireEmptyRelatedProducts": true,
        "requireLazyLoading": true,
        "requireMetaAttribute": "data-zima-compare-meta",
        "requirePublishedTrue": true,
        "requiredMarkerPairs": [
          "OVERVIEW",
          "SPECS",
          "CATEGORIES",
          "RECOMMENDATION",
          "SKU-FAMILY",
          "RESOURCES",
          "FAQ",
          "METHODOLOGY"
        ],
        "sourceKey": "",
        "template": "nas-a-vs-b",
        "verified": true
      }
